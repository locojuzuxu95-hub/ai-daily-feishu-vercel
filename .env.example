# 必填：你的 OpenAI 兼容 API Key（可使用 Uni 等中转服务）
OPENAI_API_KEY=

# 可选：OpenAI 兼容 API Base URL
# 官方默认：https://api.openai.com/v1
# 使用 Uni 时请填写 Uni 提供的 OpenAI 兼容 Base URL，例如 https://xxx/v1
OPENAI_BASE_URL=

# 必填：飞书群自定义机器人 Webhook
FEISHU_WEBHOOK=

# 必填：随机长字符串，建议 32-64 位
CRON_SECRET=

# 可选：模型名必须填写 Uni 实际支持的模型 ID
OPENAI_MODEL=gpt-5.6-sol

# 可选：none / low / medium / high / xhigh / max
OPENAI_REASONING_EFFORT=high
